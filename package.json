{
  "name": "buildtogether",
  "version": "0.1.0",
  "private": true,
  "description": "BuildTogether - build real projects, document the work, teach what you learn, earn from your skills.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:seed:first-boot": "tsx db/seed-if-empty.ts",
    "db:reset": "tsx db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "drizzle-orm": "0.44.6",
    "lucide-react": "0.470.0",
    "next": "^15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.10.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.5",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
