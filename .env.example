# ---------------------------------------------------------------------------
# BuildTogether - environment template
# Copy to .env.local for local development:  cp .env.example .env.local
# NEVER commit real values. All values below are placeholders.
# ---------------------------------------------------------------------------

# Public base URL used for cookies, canonical links and verification emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database ---------------------------------------------------------------
# SQLite file used by this build (Drizzle ORM). A PostgreSQL deployment is
# documented in docs/DEPLOYMENT.md; the schema is written to be portable.
DATABASE_PATH="./data/buildtogether.db"

# --- Session / crypto ------------------------------------------------------
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-me-with-a-32-byte-random-base64-value"
# Session lifetime in days
SESSION_TTL_DAYS="30"

# --- Email adapter ---------------------------------------------------------
# "console" (default, no external service) or "smtp" once configured.
EMAIL_PROVIDER="console"
EMAIL_FROM="BuildTogether <no-reply@buildtogether.example>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Object storage adapter ------------------------------------------------
# "local" (default, private folder served through authorised routes) or "s3".
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- AI adapters -----------------------------------------------------------
# "local" (deterministic storyboard/narration generator, no network) or a
# hosted provider once configured. Never expose these in client code.
AI_PROVIDER="local"
AI_API_KEY=""
AI_MODEL=""

# "local" (SVG/CSS animated explainer export) or a real motion/video provider.
VIDEO_PROVIDER="local"
VIDEO_API_KEY=""

# --- Payments --------------------------------------------------------------
# Intentionally disabled in this build. Premium learning access is granted
# through creator/admin entitlement workflows. Do not enable a rail until
# marketplace eligibility, KYC and consumer-law review are complete.
PAYMENTS_ENABLED="false"

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB="10"
ALLOWED_UPLOAD_TYPES="image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,audio/mpeg,audio/webm,video/mp4"

# --- Rate limiting ---------------------------------------------------------
# Fixed-window limits per identifier (per minute).
RATE_LIMIT_AUTH_PER_MINUTE="10"
RATE_LIMIT_WRITE_PER_MINUTE="60"
RATE_LIMIT_AI_PER_HOUR="12"

# --- Destructive development commands -------------------------------------
# `npm run db:seed` deletes every row before inserting demo fixtures. It already
# refuses to run when NODE_ENV=production, and refuses to wipe a database that
# contains any account not ending in @example.test. Set this to "1" ONLY if you
# are certain the target database holds nothing you need to keep.
SEED_ALLOW_NON_DEMO=""
